---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleMeta from '../../components/ArticleMeta.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import PetalMark from '../../components/PetalMark.astro';
import { getAllArticles, getCategoryCounts, getReadingTime } from '../../lib/articles';
import { topics, type Topic } from '../../data/topics';

export function getStaticPaths() {
  return topics.map((topic, index) => ({
    params: { topic: topic.slug },
    props: { topic, index },
  }));
}

interface Props {
  topic: Topic;
  index: number;
}

const { topic, index } = Astro.props;
const allArticles = await getAllArticles();
const articles = allArticles.filter((article) => article.data.category === topic.category);
const counts = getCategoryCounts(allArticles);
const otherTopics = topics.filter((entry) => entry.slug !== topic.slug);
const latest = articles[0]?.data.pubDate;

const site = Astro.site ?? new URL('https://blossie-blog.vercel.app');
const base = site.toString().replace(/\/$/, '');
const canonical = new URL(`/topics/${topic.slug}/`, site).toString();

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${topic.name} — Blossie`,
  description: topic.description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'Blossie', url: base },
  hasPart: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.data.title,
    url: new URL(`/journal/${article.id}/`, site).toString(),
    datePublished: article.data.pubDate.toISOString(),
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: base },
    { '@type': 'ListItem', position: 2, name: 'Topics', item: `${base}/topics/` },
    { '@type': 'ListItem', position: 3, name: topic.name, item: canonical },
  ],
};
---

<BaseLayout
  title={topic.name}
  description={topic.shortDescription}
  image="/og-default.jpg"
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <header class="topic-hero">
    <div class="container topic-hero__inner">
      <div class="topic-hero__copy">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Topics', href: '/topics/' },
            { label: topic.name },
          ]}
        />
        <p class="eyebrow topic-hero__eyebrow">
          <span class="eyebrow__rule" aria-hidden="true"></span>
          Subject {String(index + 1).padStart(2, '0')} of {String(topics.length).padStart(2, '0')}
        </p>
        <h1 class="topic-hero__title">{topic.name}</h1>
        <p class="topic-hero__description">{topic.description}</p>
        <div class="topic-hero__meta">
          <span>{articles.length} {articles.length === 1 ? 'story' : 'stories'}</span>
          {latest && (
            <>
              <span class="meta__dot" aria-hidden="true"></span>
              <span>Updated {latest.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</span>
            </>
          )}
        </div>
        <a class="text-link" href="/journal/">
          Read the whole journal
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="topic-hero__media">
        <div class="topic-hero__frame image-reveal">
          <Image
            src={topic.image}
            alt={topic.imageAlt}
            widths={[480, 640, 800, 1000]}
            sizes="(min-width: 900px) 36vw, 92vw"
            format="webp"
            quality={84}
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="topic-hero__mark" aria-hidden="true">
          <PetalMark size={34} />
        </span>
      </div>
    </div>
  </header>

  <section class="topic-stories section--sm" aria-labelledby="topic-stories-heading">
    <div class="container">
      <SectionHeading
        eyebrow={`In ${topic.name.toLowerCase()}`}
        title={articles.length === 1 ? 'A story to begin with.' : 'Stories to linger over.'}
        description={`Every ${topic.name.toLowerCase()} story lives here. Read one, then follow the threads at the end.`}
        id="topic-stories-heading"
      />

      <div class="story-list">
        {articles.map((article, articleIndex) => {
          const readingTime = getReadingTime(article);
          return (
            <article class:list={['story-row', { 'story-row--reverse': articleIndex % 2 === 1 }]}>
              <a class="story-row__media image-reveal" href={`/journal/${article.id}/`} tabindex="-1" aria-hidden="true">
                <Image
                  src={article.data.cover}
                  alt={article.data.coverAlt}
                  widths={[400, 640, 800, 1000]}
                  sizes="(min-width: 900px) 45vw, 92vw"
                  format="webp"
                  quality={82}
                  loading={articleIndex === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
              <div class="story-row__body">
                <div class="story-row__topline">
                  <span class="category">{article.data.category}</span>
                  <span class="story-row__index">
                    {String(articleIndex + 1).padStart(2, '0')}
                  </span>
                </div>
                <h3 class="story-row__title">
                  <a class="title-link" href={`/journal/${article.id}/`}>{article.data.title}</a>
                </h3>
                <p class="story-row__excerpt">{article.data.excerpt}</p>
                <ArticleMeta date={article.data.pubDate} readingTime={readingTime} />
                <a class="text-link story-row__link" href={`/journal/${article.id}/`}>
                  Read the story
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="other-topics" aria-labelledby="other-topics-heading">
    <div class="container other-topics__inner">
      <div class="other-topics__intro">
        <p class="eyebrow">
          <span class="eyebrow__rule" aria-hidden="true"></span>
          Keep wandering
        </p>
        <h2 id="other-topics-heading">Other subjects<br /><em>to follow.</em></h2>
      </div>
      <div class="other-topics__list">
        {otherTopics.map((entry) => (
          <a class="other-topic" href={`/topics/${entry.slug}/`}>
            <span class="other-topic__number">
              {String(topics.findIndex((item) => item.slug === entry.slug) + 1).padStart(2, '0')}
            </span>
            <span class="other-topic__name">{entry.name}</span>
            <span class="other-topic__count">{counts.get(entry.category) ?? 0}</span>
            <Icon name="arrow-up-right" size={15} class="other-topic__arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-hero {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 5.5rem);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }

  .topic-hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .topic-hero__eyebrow {
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .topic-hero__title {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 2.2rem + 4.8vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .topic-hero__description {
    max-width: 36rem;
    margin-top: 1.3rem;
    font-size: var(--text-md);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .topic-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    margin-top: 1.4rem;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .topic-hero__copy .text-link {
    margin-top: 1.5rem;
  }

  .topic-hero__media {
    position: relative;
    justify-self: end;
    width: min(100%, 30rem);
  }

  .topic-hero__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface);
    border-radius: var(--arch);
  }

  .topic-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--image-tone);
  }

  .topic-hero__mark {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    color: var(--rose);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .story-list {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .story-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .story-row--reverse .story-row__media {
    order: 2;
  }

  .story-row__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    border-radius: var(--arch);
  }

  .story-row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--image-tone);
  }

  .story-row__body {
    max-width: 32rem;
  }

  .story-row__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .story-row__index {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--rose);
  }

  .story-row__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.7rem + 1.4vw, 3.15rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .story-row__excerpt {
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--muted);
  }

  .story-row__body .meta {
    margin-top: 1rem;
  }

  .story-row__link {
    margin-top: 1.25rem;
  }

  .other-topics {
    padding-block: var(--section-y);
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }

  .other-topics__inner {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .other-topics h2 {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.8rem + 1.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }

  .other-topics h2 em {
    font-style: italic;
    color: var(--berry);
  }

  .other-topics__list {
    border-top: 1px solid var(--line-strong);
  }

  .other-topic {
    display: grid;
    grid-template-columns: 2rem 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--line);
    transition: color var(--duration-fast) ease;
  }

  .other-topic__number {
    font-size: var(--text-2xs);
    color: var(--rose);
  }

  .other-topic__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .other-topic__count {
    font-size: var(--text-2xs);
    color: var(--faint);
  }

  .other-topic__arrow {
    color: var(--faint);
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-base) var(--ease-out);
  }

  .other-topic:hover {
    color: var(--accent);
  }

  .other-topic:hover .other-topic__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 880px) {
    .topic-hero__inner {
      grid-template-columns: 1fr;
    }

    .topic-hero__media {
      justify-self: start;
      width: min(100%, 26rem);
    }

    .other-topics__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .story-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .story-row--reverse .story-row__media {
      order: 0;
    }
  }

  @media (max-width: 460px) {
    .other-topic {
      grid-template-columns: 1.5rem 1fr auto;
    }

    .other-topic__count {
      display: none;
    }
  }
</style>
