---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PetalMark from '../components/PetalMark.astro';
import {
  formatDate,
  formatDay,
  getAllArticles,
  getArchiveGroups,
  getCategoryCounts,
  getReadingTime,
} from '../lib/articles';
import { topics } from '../data/topics';

const articles = await getAllArticles();
const groups = getArchiveGroups(articles);
const counts = getCategoryCounts(articles);
const first = articles.at(-1);
const latest = articles[0];

const site = Astro.site ?? new URL('https://blossie-blog.vercel.app');
const base = site.toString().replace(/\/$/, '');
const canonical = new URL('/archive/', site).toString();

const archiveSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Blossie Archive',
  description: 'Every story published in Blossie, arranged by month.',
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'Blossie', url: base },
  hasPart: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.data.title,
    url: new URL(`/journal/${article.id}/`, site).toString(),
    datePublished: article.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout
  title="The Archive"
  description="Every Blossie story in one place, arranged by month — a quiet archive of essays on style, beauty, home, wellness, culture, and ordinary life."
  jsonLd={archiveSchema}
>
  <header class="archive-hero">
    <div class="container archive-hero__inner">
      <div>
        <p class="eyebrow">
          <span class="eyebrow__rule" aria-hidden="true"></span>
          The Archive
        </p>
        <h1 class="page-hero__title archive-hero__title">
          Everything,<br /><em>in its season.</em>
        </h1>
      </div>
      <div class="archive-hero__aside">
        <p>
          A journal is also a record: of what we noticed, what we made room for,
          and what we decided was worth saying out loud.
        </p>
        <div class="archive-hero__stats">
          <span>{articles.length} stories</span>
          <span class="meta__dot" aria-hidden="true"></span>
          <span>{topics.length} subjects</span>
          {first && latest && (
            <>
              <span class="meta__dot" aria-hidden="true"></span>
              <span>
                {first.data.pubDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })} – {latest.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}
              </span>
            </>
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="container archive-layout">
    <aside class="archive-aside">
      <div class="archive-aside__sticky">
        <PetalMark size={28} />
        <p class="eyebrow">A note on archives</p>
        <p class="archive-aside__note">
          Nothing here expires. Read in order, follow a thread, or begin with a
          title that catches your eye.
        </p>
        <nav class="archive-aside__subjects" aria-label="Browse by subject">
          <p class="archive-aside__label">Subjects</p>
          {topics.map((topic) => (
            <a href={`/topics/${topic.slug}/`}>
              <span>{topic.name}</span>
              <span>{counts.get(topic.category) ?? 0}</span>
            </a>
          ))}
        </nav>
        <div class="archive-aside__links">
          <a class="text-link" href="/search/">
            Search the archive
            <Icon name="search" size={13} />
          </a>
          <a class="text-link" href="/rss.xml">
            RSS feed
            <Icon name="rss" size={13} />
          </a>
        </div>
      </div>
    </aside>

    <div class="archive-main">
      {groups.map((year) => (
        <section class="archive-year" aria-labelledby={`year-${year.year}`}>
          <div class="archive-year__head">
            <h2 id={`year-${year.year}`}>{year.year}</h2>
            <span>
              {year.months.reduce((total, month) => total + month.articles.length, 0)} stories
            </span>
          </div>

          {year.months.map((month) => (
            <div class="archive-month">
              <div class="archive-month__head">
                <h3>{month.label}</h3>
                <span>{String(month.articles.length).padStart(2, '0')}</span>
              </div>
              <div class="archive-month__list">
                {month.articles.map((article) => (
                  <article class="archive-entry">
                    <time class="archive-entry__date" datetime={article.data.pubDate.toISOString()}>
                      <span class="archive-entry__day">{formatDay(article.data.pubDate)}</span>
                      <span class="archive-entry__full">{formatDate(article.data.pubDate)}</span>
                    </time>
                    <div class="archive-entry__body">
                      <span class="category">{article.data.category}</span>
                      <h4>
                        <a class="title-link" href={`/journal/${article.id}/`}>{article.data.title}</a>
                      </h4>
                    </div>
                    <span class="archive-entry__read">{getReadingTime(article)} min</span>
                    <a class="archive-entry__arrow" href={`/journal/${article.id}/`} aria-label={`Read ${article.data.title}`}>
                      <Icon name="arrow-right" size={15} />
                    </a>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-hero {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }

  .archive-hero__inner {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: end;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .archive-hero__title {
    margin-top: 1rem;
    font-size: clamp(3.7rem, 2.3rem + 5vw, 7.25rem);
    line-height: 0.93;
  }

  .archive-hero__title em {
    font-style: italic;
    color: var(--berry);
  }

  .archive-hero__aside {
    max-width: 24rem;
    padding-bottom: 0.4rem;
  }

  .archive-hero__aside > p {
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .archive-hero__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    color: var(--muted);
    border-top: 1px solid var(--line-strong);
  }

  .archive-layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-block: var(--section-y);
  }

  .archive-aside__sticky {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: grid;
    gap: 1rem;
    color: var(--rose);
  }

  .archive-aside__sticky .eyebrow {
    color: var(--accent);
  }

  .archive-aside__note {
    max-width: 16rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .archive-aside__subjects {
    display: grid;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .archive-aside__label {
    margin-bottom: 0.4rem;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--faint);
  }

  .archive-aside__subjects a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
    transition: color var(--duration-fast) ease;
  }

  .archive-aside__subjects a span:last-child {
    font-size: var(--text-2xs);
    color: var(--faint);
  }

  .archive-aside__subjects a:hover {
    color: var(--accent);
  }

  .archive-aside__links {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    margin-top: 1.4rem;
  }

  .archive-year + .archive-year {
    margin-top: 3.5rem;
  }

  .archive-year__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid var(--ink);
  }

  .archive-year__head h2 {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 2.5rem + 2.6vw, 5.2rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .archive-year__head span {
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .archive-month + .archive-month {
    margin-top: 2rem;
  }

  .archive-month__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem 0.7rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .archive-month__head h3 {
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
  }

  .archive-month__head span {
    font-size: var(--text-2xs);
    color: var(--faint);
  }

  .archive-entry {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto 2.5rem;
    align-items: center;
    gap: 1rem;
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--duration-fast) ease;
  }

  .archive-entry:hover {
    background: var(--bg-soft);
  }

  .archive-entry__date {
    display: grid;
    gap: 0.1rem;
    padding-left: 0.5rem;
  }

  .archive-entry__day {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1;
    color: var(--ink);
  }

  .archive-entry__full {
    display: none;
  }

  .archive-entry__body {
    min-width: 0;
  }

  .archive-entry__body h4 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.2rem + 0.45vw, 1.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .archive-entry__read {
    font-size: var(--text-2xs);
    color: var(--faint);
    white-space: nowrap;
  }

  .archive-entry__arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      color var(--duration-base) ease,
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  .archive-entry__arrow:hover {
    color: var(--button-ink);
    background: var(--button-bg);
    border-color: var(--button-bg);
  }

  @media (max-width: 920px) {
    .archive-hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .archive-aside {
      order: 2;
    }

    .archive-layout {
      grid-template-columns: 1fr;
    }

    .archive-aside__sticky {
      position: static;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }

    .archive-aside__note {
      max-width: 30rem;
    }

    .archive-aside__subjects {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }

    .archive-aside__subjects .archive-aside__label {
      grid-column: 1 / -1;
    }

    .archive-main {
      order: 1;
    }
  }

  @media (max-width: 560px) {
    .archive-entry {
      grid-template-columns: 3.25rem minmax(0, 1fr) auto;
      gap: 0.65rem;
    }

    .archive-entry__date {
      padding-left: 0;
    }

    .archive-entry__read {
      display: none;
    }

    .archive-entry__arrow {
      width: 2rem;
      height: 2rem;
    }

    .archive-aside__subjects {
      grid-template-columns: 1fr;
    }
  }
</style>
