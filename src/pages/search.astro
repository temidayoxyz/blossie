---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PetalMark from '../components/PetalMark.astro';
import { getAllArticles } from '../lib/articles';
import { topics } from '../data/topics';

const articles = await getAllArticles();
const startingPoints = articles.slice(0, 3);
const suggestions = ['rest', 'wardrobe', 'rituals', 'skin', 'home', 'long lunch'];
---

<BaseLayout
  title="Search the Journal"
  description="Search every story in the Blossie journal by title, subject, idea, or the feeling you are trying to find."
  noindex
>
  <header class="search-hero">
    <div class="container search-hero__inner">
      <p class="eyebrow">
        <span class="eyebrow__rule" aria-hidden="true"></span>
        Search the journal
      </p>
      <h1 class="search-hero__title">
        What are you<br /><em>looking for?</em>
      </h1>
      <p class="search-hero__intro">
        A word, a subject, a half-remembered idea. Search all{' '}
        {articles.length} stories in the Blossie journal.
      </p>

      <form class="search-form" action="/search/" method="get" role="search" data-search-form>
        <label class="sr-only" for="search-input">Search the journal</label>
        <Icon name="search" size={22} class="search-form__icon" />
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="Try “rest”, “wardrobe”, or “long lunch”"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="search-hint"
          aria-keyshortcuts="/"
          data-search-input
        />
        <button class="search-form__clear" type="button" hidden data-search-clear aria-label="Clear search">
          <Icon name="close" size={16} />
        </button>
        <button class="btn search-form__submit" type="submit">
          Search
          <Icon name="arrow-right" size={15} />
        </button>
      </form>
      <p class="search-hint" id="search-hint">
        Press <kbd>/</kbd> to search · <kbd>Esc</kbd> to clear
      </p>

      <div class="search-suggestions" aria-label="Suggested searches">
        <span>Try</span>
        {suggestions.map((suggestion) => (
          <a
            href={`/search/?q=${encodeURIComponent(suggestion)}`}
            data-search-suggestion={suggestion}
          >
            {suggestion}
          </a>
        ))}
      </div>
    </div>
    <PetalMark size={360} class="search-hero__mark" />
  </header>

  <section class="search-results-section" aria-labelledby="search-results-heading">
    <div class="container search-results-layout">
      <aside class="search-aside">
        <p class="eyebrow">Results</p>
        <h2 id="search-results-heading" class="search-aside__title">From the journal</h2>
        <p class="search-status" data-search-status role="status" aria-live="polite">
          Enter a word to begin.
        </p>
        <p class="search-aside__note">
          Search looks through titles, subjects, tags, and the full text of every
          story.
        </p>
      </aside>

      <div class="search-main">
        <div class="search-initial" data-search-initial>
          <div class="search-start">
            <h2>Some places to begin.</h2>
            <div class="search-start__list">
              {startingPoints.map((article) => (
                <a class="search-start__item" href={`/journal/${article.id}/`}>
                  <span class="category">{article.data.category}</span>
                  <span class="search-start__title">{article.data.title}</span>
                  <Icon name="arrow-right" size={15} />
                </a>
              ))}
            </div>
          </div>

          <div class="search-topics">
            <p class="eyebrow">Browse by subject</p>
            <div class="search-topics__list">
              {topics.map((topic) => (
                <a href={`/topics/${topic.slug}/`}>{topic.name}</a>
              ))}
            </div>
          </div>
        </div>

        <div class="search-output" data-search-results hidden aria-busy="false">
          <p class="search-output__label" data-search-query-label></p>
          <div class="search-results-list" data-search-list></div>
        </div>

        <div class="search-empty empty-state" data-search-empty hidden>
          <PetalMark size={28} />
          <h3>Nothing matched just yet</h3>
          <p data-search-empty-copy>
            Try a broader word, a subject, or something you remember from a story.
          </p>
          <a class="btn btn--ghost" href="/journal/">Browse all stories</a>
        </div>

        <noscript>
          <div class="search-noscript">
            <p>
              Search needs JavaScript. In the meantime, you can browse the
              <a class="link-plain" href="/journal/">full journal</a>,
              <a class="link-plain" href="/topics/">all six subjects</a>, or the
              <a class="link-plain" href="/archive/">archive</a>.
            </p>
            <div class="search-noscript__links">
              {articles.map((article) => (
                <a href={`/journal/${article.id}/`}>{article.data.title}</a>
              ))}
            </div>
          </div>
        </noscript>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/search';
</script>

<style>
  .search-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }

  .search-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 55rem;
  }

  .search-hero__title {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(3.7rem, 2.2rem + 5vw, 7rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.032em;
  }

  .search-hero__title em {
    font-style: italic;
    color: var(--berry);
  }

  .search-hero__intro {
    max-width: 35rem;
    margin-top: 1.25rem;
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 46rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding: 0.45rem 0.45rem 0.45rem 1rem;
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .search-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .search-form__icon {
    color: var(--muted);
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    min-height: 3.1rem;
    padding: 0;
    font-size: var(--text-base);
    color: var(--ink);
    background: transparent;
    border: 0;
    outline: 0;
  }

  .search-form input::placeholder {
    color: var(--faint);
  }

  .search-form__clear {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    color: var(--muted);
    border-radius: 50%;
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .search-form__clear:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }

  .search-form__clear[hidden] {
    display: none;
  }

  .search-form__submit {
    flex: none;
  }

  .search-hint {
    margin-top: 0.65rem;
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  .search-hint kbd {
    display: inline-block;
    min-width: 1.3rem;
    padding: 0.1rem 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-align: center;
    color: var(--ink-soft);
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }

  .search-suggestions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
    margin-top: 1.4rem;
  }

  .search-suggestions > span {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--faint);
  }

  .search-suggestions a {
    padding: 0.32rem 0.6rem;
    font-size: var(--text-xs);
    color: var(--ink-soft);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .search-suggestions a:hover {
    color: var(--accent);
    border-color: var(--rose);
  }

  .search-hero__mark {
    position: absolute;
    right: -10rem;
    bottom: -12rem;
    color: var(--rose);
    opacity: 0.09;
    transform: rotate(22deg);
    pointer-events: none;
  }

  .search-results-section {
    padding-block: var(--section-y-sm);
  }

  .search-results-layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .search-aside {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .search-aside__title {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.15;
  }

  .search-status {
    margin-top: 1rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .search-aside__note {
    margin-top: 1.5rem;
    padding-top: 1rem;
    font-size: var(--text-2xs);
    line-height: 1.6;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }

  .search-initial {
    display: grid;
    gap: 2.5rem;
  }

  .search-start {
    padding: 1.4rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .search-start h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .search-start__list {
    margin-top: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .search-start__item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    transition: color var(--duration-fast) ease;
  }

  .search-start__item:hover {
    color: var(--accent);
  }

  .search-start__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .search-start__item svg {
    color: var(--faint);
  }

  .search-topics .eyebrow {
    margin-bottom: 0.75rem;
  }

  .search-topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .search-topics__list a {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--line-strong);
    transition:
      color var(--duration-fast) ease,
      text-decoration-color var(--duration-fast) ease;
  }

  .search-topics__list a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .search-output__label {
    margin-bottom: 0.6rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .search-results-list {
    border-top: 1px solid var(--line-strong);
  }

  :global(.search-result) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 2rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.search-result__meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  :global(.search-result__meta .category) {
    color: var(--accent);
  }

  :global(.search-result__title) {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.4rem + 0.7vw, 2.2rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.012em;
  }

  :global(.search-result__title a) {
    transition: color var(--duration-fast) ease;
  }

  :global(.search-result__title a:hover) {
    color: var(--accent);
  }

  :global(.search-result__body p) {
    max-width: 42rem;
    margin-top: 0.45rem;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--muted);
  }

  :global(.search-result__arrow) {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.3rem;
    height: 2.3rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      color var(--duration-base) ease,
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  :global(.search-result__arrow:hover) {
    color: var(--button-ink);
    background: var(--button-bg);
    border-color: var(--button-bg);
  }

  :global(.search-result mark) {
    color: var(--ink);
    background: var(--rose-soft);
    border-radius: 1px;
    padding-inline: 0.06em;
  }

  .search-empty {
    margin-top: 0;
    margin-inline: 0;
    max-width: 40rem;
  }

  .search-empty[hidden] {
    display: none;
  }

  .search-noscript {
    padding: 1.1rem;
    font-size: var(--text-sm);
    color: var(--muted);
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }

  .search-noscript__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
  }

  .search-noscript__links a {
    font-size: var(--text-xs);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 820px) {
    .search-results-layout {
      grid-template-columns: 1fr;
    }

    .search-aside {
      position: static;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--line);
    }

    .search-aside__note {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .search-form {
      flex-wrap: wrap;
      padding: 0.6rem;
    }

    .search-form__icon {
      margin-left: 0.4rem;
    }

    .search-form input {
      min-height: 2.8rem;
    }

    .search-form__submit {
      width: 100%;
    }

    .search-hint {
      display: none;
    }

    .search-start__item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 1rem;
    }

    .search-start__item .category {
      grid-column: 1 / -1;
    }

    :global(.search-result) {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.search-result__arrow) {
      display: none;
    }
  }
</style>
