---
import BaseLayout from '../layouts/BaseLayout.astro';
import PetalMark from '../components/PetalMark.astro';
import Icon from '../components/Icon.astro';
import { getAllArticles } from '../lib/articles';
import { topics } from '../data/topics';

const articles = await getAllArticles();
const recent = articles.slice(0, 2);
---

<BaseLayout
  title="Page Not Found"
  description="This page has wandered off. Return to the Blossie journal, browse the archive, or search for a story."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <span class="not-found__code" aria-hidden="true">404</span>
      <div class="not-found__mark" aria-hidden="true">
        <PetalMark size={48} />
      </div>
      <p class="eyebrow">
        <span class="eyebrow__rule" aria-hidden="true"></span>
        A wrong turn
      </p>
      <h1 id="not-found-title" class="not-found__title">
        This page has<br /><em>wandered off.</em>
      </h1>
      <p class="not-found__intro">
        The link may be old, the address may be mistyped, or the page may simply
        have gone for a walk. There is still plenty to read.
      </p>
      <div class="not-found__actions">
        <a class="btn" href="/">
          Return home
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="text-link" href="/journal/">Browse the journal</a>
      </div>

      <div class="not-found__paths">
        <div>
          <p class="eyebrow">Try a subject</p>
          <div class="not-found__topics">
            {topics.slice(0, 4).map((topic) => (
              <a href={`/topics/${topic.slug}/`}>{topic.name}</a>
            ))}
          </div>
        </div>
        <div>
          <p class="eyebrow">Or begin again</p>
          <a class="link-plain" href="/search/">Search the journal</a>
          <a class="link-plain" href="/archive/">Open the archive</a>
          <a class="link-plain" href="/rss.xml">Follow the RSS feed</a>
        </div>
      </div>

      <div class="not-found__recent">
        <p class="eyebrow">Recently in the journal</p>
        <div>
          {recent.map((article) => (
            <a href={`/journal/${article.id}/`}>
              <span class="category">{article.data.category}</span>
              <span class="not-found__recent-title">{article.data.title}</span>
              <Icon name="arrow-right" size={14} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 9rem);
    background: var(--bg-soft);
  }

  .not-found::before {
    content: '';
    position: absolute;
    top: 10%;
    left: 50%;
    width: 56rem;
    height: 56rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    transform: translateX(-50%);
    opacity: 0.5;
    pointer-events: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    max-width: 50rem;
    text-align: center;
  }

  .not-found__code {
    position: absolute;
    top: -4.5rem;
    left: 50%;
    z-index: -1;
    font-family: var(--font-display);
    font-size: clamp(11rem, 30vw, 24rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--rose);
    opacity: 0.08;
    transform: translateX(-50%);
    user-select: none;
  }

  .not-found__mark {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 1.5rem;
    color: var(--rose);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .not-found__title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 2.4rem + 5vw, 7rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.03em;
  }

  .not-found__title em {
    font-style: italic;
    color: var(--berry);
  }

  .not-found__intro {
    max-width: 31rem;
    margin-top: 1.25rem;
    font-size: var(--text-md);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem;
  }

  .not-found__paths,
  .not-found__recent {
    width: 100%;
    margin-top: clamp(2.75rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    text-align: left;
  }

  .not-found__paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .not-found__paths > div {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.5rem;
  }

  .not-found__paths .eyebrow {
    margin-bottom: 0.35rem;
  }

  .not-found__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
  }

  .not-found__topics a {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition:
      color var(--duration-fast) ease,
      text-decoration-color var(--duration-fast) ease;
  }

  .not-found__topics a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .not-found__paths .link-plain {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .not-found__recent > div {
    display: grid;
    margin-top: 0.25rem;
  }

  .not-found__recent a {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    transition: color var(--duration-fast) ease;
  }

  .not-found__recent a:hover {
    color: var(--accent);
  }

  .not-found__recent-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .not-found__recent svg {
    color: var(--faint);
  }

  @media (max-width: 620px) {
    .not-found__paths {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .not-found__recent a {
      grid-template-columns: 1fr auto;
    }

    .not-found__recent .category {
      grid-column: 1 / -1;
    }
  }
</style>
