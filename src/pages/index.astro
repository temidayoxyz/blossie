---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TopicCard from '../components/TopicCard.astro';
import PetalMark from '../components/PetalMark.astro';
import Icon from '../components/Icon.astro';
import { getAllArticles, getCategoryCounts, getReadingTime, getTopicFor } from '../lib/articles';
import { topics } from '../data/topics';

const articles = await getAllArticles();
const featured = articles.find((article) => article.data.featured) ?? articles[0];
if (!featured) throw new Error('Blossie needs at least one article to build the homepage.');

const recent = articles.filter((article) => article.id !== featured.id).slice(0, 5);
const picks = articles.filter((article) => article.data.editorsPick);
const leadPick =
  picks.find((article) => article.id === 'what-we-keep') ?? picks[0] ?? recent[0];
const otherPicks = picks
  .filter((article) => article.id !== leadPick?.id)
  .slice(0, 2);

const categoryCounts = getCategoryCounts(articles);

const leadPickTopic = leadPick ? getTopicFor(leadPick) : undefined;
const leadPickReadingTime = leadPick ? getReadingTime(leadPick) : 0;
---

<BaseLayout
  title="Blossie — A journal for the lovely little details"
  ogTitle="Blossie — A journal for the lovely little details"
  description="An independent journal about style, beauty, home, wellness, culture, and the small rituals that make an ordinary day feel like your own."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">
          <span class="eyebrow__rule" aria-hidden="true"></span>
          The Blossie Journal · Issue No. 04
        </p>
        <h1 id="hero-title" class="hero__title">
          Life is in the<br />
          <span class="hero__italic">lovely</span> little<br />
          details<span class="hero__period">.</span>
        </h1>
        <p class="hero__intro">
          A journal for the texture of ordinary life — what we wear, how we
          rest, the rooms we make, and the small rituals that make a day feel
          like ours.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/journal/">
            Read the journal
            <Icon name="arrow-right" size={15} />
          </a>
          <a class="text-link" href="/about/">
            About Blossie
            <Icon name="arrow-up-right" size={13} />
          </a>
        </div>
        <div class="hero__note">
          <PetalMark size={22} />
          <p>Ten stories, six subjects, and no particular hurry.</p>
        </div>
      </div>

      <div class="hero__feature">
        <div class="hero__feature-label">
          <span>Cover story</span>
          <span class="hero__feature-rule" aria-hidden="true"></span>
          <span>01</span>
        </div>
        <ArticleCard
          article={featured}
          variant="hero"
          headingLevel="h2"
          priority
          featuredLabel="Cover story"
        />
      </div>
    </div>
    <PetalMark size={440} class="hero__watermark" />
  </section>

  <section class="latest section" aria-labelledby="latest-heading">
    <div class="container">
      <SectionHeading
        eyebrow="New on the journal"
        title="Recently, in the journal"
        description="Fresh stories on the things that shape a day: the clothes, the rooms, the rituals, and the thoughts we make room for."
        linkHref="/journal/"
        linkLabel="All stories"
        id="latest-heading"
      />

      <div class="latest__grid">
        {recent.map((article, index) => (
          <div class:list={['latest__item', index < 2 ? 'latest__item--wide' : 'latest__item--small']}>
            <ArticleCard
              article={article}
              variant={index < 2 ? 'large' : 'standard'}
              showExcerpt={index < 2}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="picks" aria-labelledby="picks-heading">
    <div class="picks__ring" aria-hidden="true"></div>
    <div class="container picks__inner">
      <SectionHeading
        eyebrow="From the editors"
        title="Stories we keep returning to."
        description="A few pieces from the archive that still feel like part of the conversation — on rest, memory, and the tables we gather around."
        linkHref="/archive/"
        linkLabel="Browse the archive"
        tone="light"
        id="picks-heading"
      />

      {leadPick && (
        <div class="picks__grid">
          <article class="pick-lead">
            <a class="pick-lead__media image-reveal" href={`/journal/${leadPick.id}/`} tabindex="-1" aria-hidden="true">
              <Image
                src={leadPick.data.cover}
                alt={leadPick.data.coverAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 900px) 45vw, 92vw"
                format="webp"
                quality={82}
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="pick-lead__body">
              {leadPickTopic && (
                <a class="category category--light" href={`/topics/${leadPickTopic.slug}/`}>
                  {leadPick.data.category}
                </a>
              )}
              <h3 class="pick-lead__title">
                <a class="title-link" href={`/journal/${leadPick.id}/`}>{leadPick.data.title}</a>
              </h3>
              <p>{leadPick.data.excerpt}</p>
              <p class="meta meta--light">
                <time datetime={leadPick.data.pubDate.toISOString()}>{leadPick.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
                <span class="meta__dot" aria-hidden="true"></span>
                <span>{leadPickReadingTime} min read</span>
              </p>
            </div>
          </article>

          <div class="picks__side">
            <div class="pick-list">
              {otherPicks.map((pick, index) => {
                const topic = getTopicFor(pick);
                return (
                  <article class="pick-row">
                    <a class="pick-row__media image-reveal" href={`/journal/${pick.id}/`} tabindex="-1" aria-hidden="true">
                      <Image
                        src={pick.data.cover}
                        alt={pick.data.coverAlt}
                        widths={[160, 240, 360]}
                        sizes="6.25rem"
                        format="webp"
                        quality={78}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                    <div class="pick-row__body">
                      <span class="pick-row__index">0{index + 2}</span>
                      {topic && (
                        <a class="category category--light" href={`/topics/${topic.slug}/`}>
                          {pick.data.category}
                        </a>
                      )}
                      <h3>
                        <a class="title-link" href={`/journal/${pick.id}/`}>{pick.data.title}</a>
                      </h3>
                    </div>
                  </article>
                );
              })}
            </div>

            <blockquote class="picks__quote">
              <span class="picks__quote-mark" aria-hidden="true">“</span>
              <p>You do not have to earn your rest by being tired enough.</p>
              <cite>
                <a href="/journal/the-graceful-art-of-doing-less/">
                  From The Graceful Art of Doing Less
                  <Icon name="arrow-right" size={13} />
                </a>
              </cite>
            </blockquote>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="topic-section section" aria-labelledby="topics-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Explore the subjects"
        title="Six ways to linger."
        description="Every story belongs to a subject, but none of them stay neatly in one place. Start where you are curious."
        linkHref="/topics/"
        linkLabel="All topics"
        id="topics-heading"
      />

      <div class="topic-list">
        {topics.map((topic, index) => (
          <TopicCard
            topic={topic}
            count={categoryCounts.get(topic.category) ?? 0}
            index={index + 1}
            variant="row"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto" aria-labelledby="manifesto-heading">
    <div class="container manifesto__inner">
      <div class="manifesto__aside">
        <PetalMark size={30} />
        <p class="eyebrow">A note from the editors</p>
      </div>
      <div class="manifesto__copy">
        <h2 id="manifesto-heading">
          The good life is not always a bigger one. Sometimes it is a table
          cleared, a walk taken, a dress that feels like you.
        </h2>
        <p>
          Blossie is an independent editorial project about attention. We are
          interested in the details that do not announce themselves — the shape
          of a morning, the pleasure of a well-made room, the conversations that
          last longer than the meal.
        </p>
        <a class="text-link" href="/about/">
          Read about the journal
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.25rem, 7vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7.5rem);
    background:
      radial-gradient(circle at 82% 12%, color-mix(in srgb, var(--blush) 55%, transparent), transparent 31rem),
      var(--bg);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.72fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .hero__copy {
    max-width: 48rem;
    padding-block: 1rem;
  }

  .hero__eyebrow {
    margin-bottom: 1.2rem;
    animation: hero-in 800ms var(--ease-out) both;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 2.35rem + 6.2vw, 8.4rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.035em;
    text-wrap: balance;
    animation: hero-in 900ms var(--ease-out) 80ms both;
  }

  .hero__italic {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--berry);
  }

  .hero__italic::after {
    content: '';
    position: absolute;
    right: 0.04em;
    bottom: 0.08em;
    left: 0.04em;
    height: 0.08em;
    border-radius: 50%;
    background: var(--rose);
    opacity: 0.55;
    transform: rotate(-1.5deg);
  }

  .hero__period {
    color: var(--accent);
  }

  .hero__intro {
    max-width: 34rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-size: var(--text-md);
    line-height: 1.75;
    color: var(--ink-soft);
    animation: hero-in 900ms var(--ease-out) 180ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    animation: hero-in 900ms var(--ease-out) 260ms both;
  }

  .hero__note {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.1rem;
    max-width: 26rem;
    color: var(--rose);
    border-top: 1px solid var(--line);
    animation: hero-in 900ms var(--ease-out) 340ms both;
  }

  .hero__note p {
    font-size: var(--text-2xs);
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .hero__feature {
    width: min(100%, 26.5rem);
    justify-self: end;
    animation: hero-in 1000ms var(--ease-out) 220ms both;
  }

  .hero__feature-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.85rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__feature-rule {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .hero__watermark {
    position: absolute;
    right: -9rem;
    bottom: -12rem;
    color: var(--rose);
    opacity: 0.07;
    transform: rotate(-18deg);
    pointer-events: none;
  }

  .latest__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(2rem, 4vw, 3.25rem) clamp(1rem, 2.5vw, 2rem);
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .latest__item--wide {
    grid-column: span 3;
  }

  .latest__item--small {
    grid-column: span 2;
  }

  .picks {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-y);
    color: var(--contrast-ink);
    background: var(--contrast-bg);
  }

  .picks__ring {
    position: absolute;
    top: -14rem;
    right: -10rem;
    width: 38rem;
    height: 38rem;
    border: 1px solid var(--contrast-line);
    border-radius: 50%;
    opacity: 0.6;
    pointer-events: none;
  }

  .picks__inner {
    position: relative;
    z-index: 1;
  }

  .picks__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pick-lead__media {
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--contrast-bg-soft);
    border-radius: var(--radius-sm);
  }

  .pick-lead__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.02);
  }

  .pick-lead__body {
    padding-top: 1.15rem;
  }

  .pick-lead__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.5vw, 3.1rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: var(--tracking-tight);
    color: var(--contrast-ink);
    text-wrap: balance;
  }

  .pick-lead__body > p:not(.meta) {
    max-width: 30rem;
    margin-top: 0.8rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--contrast-muted);
  }

  .pick-lead__body .meta {
    margin-top: 1rem;
  }

  .picks__side {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .pick-list {
    border-top: 1px solid var(--contrast-line);
  }

  .pick-row {
    display: grid;
    grid-template-columns: 6.25rem 1fr;
    gap: 1.2rem;
    align-items: center;
    padding-block: 1.3rem;
    border-bottom: 1px solid var(--contrast-line);
  }

  .pick-row__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--contrast-bg-soft);
    border-radius: var(--radius-xs);
  }

  .pick-row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.02);
  }

  .pick-row__body {
    min-width: 0;
  }

  .pick-row__index {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    color: var(--rose);
  }

  .pick-row__body h3 {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.25rem + 0.6vw, 1.9rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--contrast-ink);
  }

  .picks__quote {
    position: relative;
    padding: 2rem 1.75rem 1.5rem;
    border: 1px solid var(--contrast-line);
    border-radius: var(--radius-sm);
    background: var(--contrast-bg-soft);
  }

  .picks__quote-mark {
    position: absolute;
    top: 0.4rem;
    left: 1rem;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: var(--rose);
    opacity: 0.45;
  }

  .picks__quote p {
    position: relative;
    max-width: 28rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 1.3rem + 0.9vw, 2.1rem);
    font-style: italic;
    line-height: 1.25;
    color: var(--contrast-ink);
  }

  .picks__quote cite {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-style: normal;
    letter-spacing: 0.06em;
    color: var(--contrast-muted);
  }

  .picks__quote cite a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color var(--duration-fast) ease;
  }

  .picks__quote cite a:hover {
    color: var(--contrast-ink);
  }

  .topic-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2.5rem, 7vw, 6rem);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  .manifesto {
    padding-block: var(--section-y);
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }

  .manifesto__inner {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .manifesto__aside {
    display: grid;
    gap: 1.2rem;
    color: var(--rose);
  }

  .manifesto__aside .eyebrow {
    align-self: end;
  }

  .manifesto__copy h2 {
    max-width: 52rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.65rem + 1.9vw, 3.65rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    text-wrap: balance;
  }

  .manifesto__copy p {
    max-width: 36rem;
    margin-top: 1.4rem;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--muted);
  }

  .manifesto__copy .text-link {
    margin-top: 1.6rem;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero__copy {
      max-width: 44rem;
    }

    .hero__feature {
      width: min(100%, 31rem);
      justify-self: start;
    }

    .hero__watermark {
      right: -16rem;
      bottom: -6rem;
    }

    .latest__grid {
      grid-template-columns: 1fr 1fr;
    }

    .latest__item--wide,
    .latest__item--small {
      grid-column: auto;
    }

    .latest__item:last-child {
      grid-column: span 2;
      max-width: calc(50% - 0.5rem);
    }

    .picks__grid {
      grid-template-columns: 1fr;
    }

    .pick-lead {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 1.75rem;
      align-items: center;
    }

    .pick-lead__body {
      padding-top: 0;
    }

    .manifesto__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .manifesto__aside {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }

  @media (max-width: 720px) {
    .hero__title {
      font-size: clamp(3.5rem, 12vw, 6rem);
    }

    .latest__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .latest__item:last-child {
      grid-column: auto;
      max-width: none;
    }

    .pick-lead {
      display: block;
    }

    .pick-lead__body {
      padding-top: 1rem;
    }

    .topic-list {
      grid-template-columns: 1fr;
    }

    .topic-list :global(.topic-card--row:first-child) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 480px) {
    .hero__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.2rem;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .pick-row {
      grid-template-columns: 5rem 1fr;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__title,
    .hero__intro,
    .hero__actions,
    .hero__note,
    .hero__feature {
      animation: none;
    }
  }
</style>
