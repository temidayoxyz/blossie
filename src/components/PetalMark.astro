---
interface Props {
  size?: number;
  class?: string;
  filled?: boolean;
}

const { size = 20, class: className, filled = true } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g
    fill={filled ? 'currentColor' : 'none'}
    stroke={filled ? 'none' : 'currentColor'}
    stroke-width={filled ? undefined : '1.1'}
    stroke-linejoin="round"
  >
    <path d="M15.3 15.6C10.7 11.1 11.8 3.9 16.7 3.1c4.4-.7 6.5 5.2 3 9.5-.9 1.1-2.4 2.2-4.4 3Z" opacity=".9" />
    <path d="M16.5 15.2c5-4.3 11.4-2.5 11.9 2.3.5 4.4-5.5 6-9.7 2.4-1.2-1-1.9-2.1-2.2-4.7Z" opacity=".72" />
    <path d="M15.4 17.1c2.5 6.4-1.9 11.2-6 9.5-3.9-1.6-2.6-7.4 3.4-9.9.8-.3 1.5-.2 2.6.4Z" opacity=".82" />
    <path d="M16 16.4c-5.9 3.6-11.3.3-9.9-4.3 1.4-4.3 7.2-3.2 9.7 1.8.3.7.4 1.5.2 2.5Z" opacity=".62" />
  </g>
  <circle cx="16" cy="16" r="1.15" fill={filled ? 'var(--bg)' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="1" />
</svg>
