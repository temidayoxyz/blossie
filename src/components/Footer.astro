---
import Wordmark from './Wordmark.astro';
import PetalMark from './PetalMark.astro';
import Icon from './Icon.astro';
import { topics } from '../data/topics';

const year = new Date().getFullYear();

const explore = [
  { href: '/journal/', label: 'The Journal' },
  { href: '/topics/', label: 'Topics' },
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About Blossie' },
  { href: '/search/', label: 'Search' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__masthead">
      <div class="site-footer__brand">
        <Wordmark tone="light" size="footer" />
        <p class="site-footer__statement">
          An independent journal for the lovely little details of ordinary life.
        </p>
      </div>
      <a class="site-footer__letter-link" href="#newsletter">
        <span class="site-footer__letter-label">
          <span class="eyebrow eyebrow--light">The Blossie Letter</span>
          <span>A little loveliness, now and then.</span>
        </span>
        <span class="site-footer__letter-icon">
          <Icon name="mail" size={20} />
        </span>
      </a>
    </div>

    <div class="site-footer__columns">
      <nav class="footer-column" aria-label="Explore">
        <h2 class="footer-column__title">Explore</h2>
        <ul>
          {explore.map((item) => (
            <li><a class="footer-link" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-column" aria-label="Topics">
        <h2 class="footer-column__title">Subjects</h2>
        <ul>
          {topics.map((topic) => (
            <li><a class="footer-link" href={`/topics/${topic.slug}/`}>{topic.name}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-column footer-column--note">
        <h2 class="footer-column__title">Elsewhere</h2>
        <ul>
          <li>
            <a class="footer-link" href="/rss.xml">
              RSS feed
              <Icon name="rss" size={13} />
            </a>
          </li>
          <li><a class="footer-link" href="/search/">Search the journal</a></li>
        </ul>
        <div class="footer-note">
          <PetalMark size={20} />
          <p>
            Ten stories, six subjects, and a little room to think. Made for long
            breakfasts and unhurried afternoons.
          </p>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Blossie. A journal of ordinary things.</p>
      <p>Photography via Pexels and Unsplash.</p>
      <p class="site-footer__built">Made slowly, with <a class="footer-link" href="https://astro.build" rel="noopener noreferrer" target="_blank">Astro</a>.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    color: var(--contrast-ink);
    background: var(--contrast-bg);
  }

  .site-footer::after {
    content: '';
    position: absolute;
    right: clamp(-10rem, -5vw, -3rem);
    bottom: -12rem;
    width: clamp(24rem, 45vw, 40rem);
    height: clamp(24rem, 45vw, 40rem);
    border: 1px solid var(--contrast-line);
    border-radius: 50%;
    opacity: 0.45;
    pointer-events: none;
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
  }

  .site-footer__masthead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--contrast-line);
  }

  .site-footer__brand {
    max-width: 32rem;
  }

  .site-footer__statement {
    margin-top: 1.1rem;
    max-width: 25rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--contrast-muted);
  }

  .site-footer__letter-link {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--contrast-line);
    border-radius: var(--radius-xs);
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  .site-footer__letter-link:hover {
    background: var(--contrast-bg-soft);
    border-color: rgba(251, 242, 237, 0.3);
  }

  .site-footer__letter-label {
    display: grid;
    gap: 0.4rem;
  }

  .site-footer__letter-label > span:last-child {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.2;
    color: var(--contrast-ink);
  }

  .site-footer__letter-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--contrast-bg);
    background: var(--contrast-ink);
    border-radius: 50%;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-footer__letter-link:hover .site-footer__letter-icon {
    transform: rotate(-8deg);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: 0.8fr 0.8fr 1.4fr;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-column__title {
    margin-bottom: 1.3rem;
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--contrast-muted);
  }

  .footer-column ul {
    display: grid;
    gap: 0.7rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--contrast-ink);
    transition: color var(--duration-fast) ease;
  }

  .footer-link:hover {
    color: var(--rose);
  }

  .footer-column--note {
    padding-left: clamp(0rem, 3vw, 2.5rem);
    border-left: 1px solid var(--contrast-line);
  }

  .footer-note {
    display: flex;
    gap: 0.9rem;
    margin-top: 2rem;
    color: var(--rose);
  }

  .footer-note p {
    max-width: 20rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--contrast-muted);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 2rem;
    padding-top: 1.5rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.03em;
    color: var(--contrast-muted);
    border-top: 1px solid var(--contrast-line);
  }

  .site-footer__built {
    margin-left: auto;
  }

  .site-footer__bottom .footer-link {
    font-size: inherit;
    border-bottom: 1px solid var(--contrast-line);
  }

  @media (max-width: 760px) {
    .site-footer__masthead {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .site-footer__letter-link {
      width: 100%;
      justify-content: space-between;
    }

    .site-footer__columns {
      grid-template-columns: 1fr 1fr;
    }

    .footer-column--note {
      grid-column: 1 / -1;
      padding-top: 2rem;
      padding-left: 0;
      border-top: 1px solid var(--contrast-line);
      border-left: 0;
    }

    .site-footer__built {
      margin-left: 0;
    }
  }

  @media (max-width: 480px) {
    .site-footer__columns {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
