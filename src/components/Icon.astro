---
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'search'
    | 'close'
    | 'menu'
    | 'sun'
    | 'moon'
    | 'system'
    | 'copy'
    | 'share'
    | 'check'
    | 'chevron-down'
    | 'rss'
    | 'mail';
  size?: number;
  strokeWidth?: number;
  title?: string;
  class?: string;
}

const { name, size = 16, strokeWidth = 1.5, title, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-right': '<path d="M3 8h10M9.5 4.5 13 8l-3.5 3.5"/>',
  'arrow-up-right': '<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"/>',
  search: '<circle cx="7.2" cy="7.2" r="4.7"/><path d="m10.7 10.7 3.1 3.1"/>',
  close: '<path d="m3.5 3.5 9 9m0-9-9 9"/>',
  menu: '<path d="M2.5 5h11M2.5 11h11"/>',
  sun: '<circle cx="8" cy="8" r="2.9"/><path d="M8 1.2v1.5M8 13.3v1.5M1.2 8h1.5M13.3 8h1.5M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1"/>',
  moon: '<path d="M13.3 9.7A5.7 5.7 0 0 1 6.3 2.7a5.7 5.7 0 1 0 7 7Z"/>',
  system: '<rect x="2.2" y="2.8" width="11.6" height="8" rx="1.2"/><path d="M6 13.2h4M8 10.8v2.4"/>',
  copy: '<rect x="5.2" y="5.2" width="8.4" height="8.4" rx="1.2"/><path d="M10.8 5.2V3.6A1.2 1.2 0 0 0 9.6 2.4H3.6A1.2 1.2 0 0 0 2.4 3.6v6A1.2 1.2 0 0 0 3.6 10.8h1.6"/>',
  share: '<circle cx="12" cy="3.3" r="1.8"/><circle cx="4" cy="8" r="1.8"/><circle cx="12" cy="12.7" r="1.8"/><path d="m5.7 7.1 4.7-2.7M5.7 8.9l4.7 2.7"/>',
  check: '<path d="m3 8.2 3.2 3.2L13 4.8"/>',
  'chevron-down': '<path d="m4 6 4 4 4-4"/>',
  rss: '<circle cx="3.4" cy="12.6" r="1.2" fill="currentColor" stroke="none"/><path d="M2.5 7.8a5.7 5.7 0 0 1 5.7 5.7M2.5 3.2a10.3 10.3 0 0 1 10.3 10.3"/>',
  mail: '<rect x="2" y="3.5" width="12" height="9" rx="1.2"/><path d="m2.8 4.4 5.2 4.2 5.2-4.2"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={paths[name]} />
</svg>
