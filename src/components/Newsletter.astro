---
import Icon from './Icon.astro';
import PetalMark from './PetalMark.astro';
---

<section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
  <div class="container newsletter__inner">
    <div class="newsletter__copy">
      <p class="eyebrow">
        <span class="eyebrow__rule" aria-hidden="true"></span>
        The Blossie Letter
      </p>
      <h2 id="newsletter-title" class="newsletter__title">
        A letter for the<br /><em>in-between.</em>
      </h2>
      <p class="newsletter__intro">
        New stories, good things to read, and small reasons to look up. Sent
        rarely, and never just to fill an inbox.
      </p>
      <div class="newsletter__petal" aria-hidden="true">
        <PetalMark size={54} />
      </div>
    </div>

    <div class="newsletter__form-wrap">
      <form class="newsletter-form" data-newsletter novalidate>
        <label class="newsletter-form__label" for="newsletter-email">Email address</label>
        <div class="newsletter-form__row">
          <input
            id="newsletter-email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@example.com"
            aria-describedby="newsletter-note newsletter-feedback"
            required
          />
          <button class="btn newsletter-form__button" type="submit">
            Join the letter
            <Icon name="arrow-right" size={15} />
          </button>
        </div>
        <p class="newsletter-form__note" id="newsletter-note">
          This is a design demo. Your address will not be stored, sent, or shared.
        </p>
        <p class="newsletter-form__feedback" id="newsletter-feedback" data-newsletter-feedback role="status"></p>
      </form>
      <noscript>
        <p class="newsletter-form__note">
          This demo form needs JavaScript to show its confirmation. No address is
          transmitted in any case.
        </p>
      </noscript>
      <p class="newsletter__detail">
        <span>No spam</span>
        <span class="newsletter__dot" aria-hidden="true"></span>
        <span>Unsubscribe whenever you like</span>
        <span class="newsletter__dot" aria-hidden="true"></span>
        <span>In the real world, presumably</span>
      </p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--blush);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .newsletter::before {
    content: '';
    position: absolute;
    top: -8rem;
    right: -4rem;
    width: 22rem;
    height: 22rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    opacity: 0.55;
    pointer-events: none;
  }

  .newsletter__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .newsletter__title {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2rem + 2.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    color: var(--berry-deep);
  }

  .newsletter__title em {
    font-style: italic;
    color: var(--accent);
  }

  .newsletter__intro {
    max-width: 26rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .newsletter__petal {
    position: absolute;
    top: 0;
    right: 2rem;
    color: var(--rose);
    opacity: 0.65;
    transform: rotate(12deg);
  }

  .newsletter__form-wrap {
    padding-bottom: 0.25rem;
  }

  .newsletter-form {
    max-width: 32rem;
  }

  .newsletter-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .newsletter-form__row {
    display: flex;
    align-items: stretch;
    gap: 0.6rem;
  }

  .newsletter-form input {
    min-width: 0;
    flex: 1;
    min-height: 3.125rem;
    padding: 0.7rem 0.9rem;
    font-size: var(--text-sm);
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xs);
    outline: 0;
    transition:
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .newsletter-form input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .newsletter-form input::placeholder {
    color: var(--faint);
  }

  .newsletter-form__button {
    flex: none;
  }

  .newsletter-form__note {
    margin-top: 0.7rem;
    font-size: var(--text-2xs);
    line-height: 1.6;
    color: var(--muted);
  }

  .newsletter-form__feedback {
    min-height: 1.5rem;
    margin-top: 0.55rem;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--accent);
  }

  .newsletter-form__feedback.is-error {
    color: #a23c4b;
  }

  .newsletter__detail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
    max-width: 30rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    font-size: var(--text-2xs);
    line-height: 1.5;
    color: var(--muted);
    border-top: 1px solid var(--line-strong);
  }

  .newsletter__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.65;
  }

  @media (max-width: 820px) {
    .newsletter__inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .newsletter__petal {
      right: 0;
      top: 0;
    }
  }

  @media (max-width: 540px) {
    .newsletter__petal {
      display: none;
    }

    .newsletter-form__row {
      flex-direction: column;
    }

    .newsletter-form__button {
      width: 100%;
    }
  }
</style>
