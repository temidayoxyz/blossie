---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  mainClass?: string;
}

const {
  title,
  description,
  ogTitle,
  image,
  imageAlt,
  type,
  publishedTime,
  modifiedTime,
  noindex,
  jsonLd,
  bodyClass,
  mainClass,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme-choice="system">
  <head>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('blossie:theme');
        } catch {
          stored = null;
        }
        const choice = stored === 'light' || stored === 'dark' ? stored : 'system';
        root.dataset.themeChoice = choice;
        if (choice !== 'system') root.dataset.theme = choice;
      })();
    </script>
    <BaseHead
      title={title}
      ogTitle={ogTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Newsletter />
    <Footer />

    <div class="toast-region" aria-live="polite" aria-atomic="true">
      <p class="toast" data-toast hidden></p>
    </div>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .toast-region {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    left: var(--space-4);
    z-index: 300;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .toast {
    max-width: 26rem;
    padding: 0.8rem 1rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--contrast-ink);
    background: var(--contrast-bg);
    border: 1px solid var(--contrast-line);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-soft);
    animation: toast-in 260ms var(--ease-out);
  }

  .toast[hidden] {
    display: none;
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      animation: none;
    }
  }
</style>
